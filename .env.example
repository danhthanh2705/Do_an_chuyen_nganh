# ---------- MongoDB ----------
# ChÃ¡ÂºÂ¡y ngoÃƒÂ i Docker: MongoDB Community local hoÃ¡ÂºÂ·c Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/supermarket?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Docker Compose ghi Ã„â€˜ÃƒÂ¨ URI thÃƒÂ nh hostname dÃ¡Â»â€¹ch vÃ¡Â»Â¥ mongo.
MONGO_URI=mongodb://127.0.0.1:27017/supermarket?replicaSet=rs0

# ---------- Backend (NestJS) ----------
BACKEND_PORT=3000
JWT_ACCESS_SECRET=dev-only-access-secret-replace-with-at-least-32-characters
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_COST=12
FRONTEND_URL=http://localhost:5173
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Muadee <no-reply@muadee.vn>
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=90000

# Cloudinary: luu anh san pham tren cloud de moi may deu thay anh (cloudinary.com > Dashboard > API Keys)
CLOUDINARY_URL=
# Thanh toÃƒÂ¡n (dÃƒÂ¹ng VietQR; webhook HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
PAYMENT_CARD_CHECKOUT_URL=
PAYMENT_CARD_API_KEY=
CARRIER_API_KEY=

# ---------- AI Service (FastAPI) ----------
AI_SERVICE_PORT=8000
# anthropic | openai | ollama (anthropic = Claude)
LLM_PROVIDER=anthropic
# Dien ANTHROPIC_API_KEY (sk-ant-...) de bat Claude; de trong = fallback tim kiem
LLM_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-haiku-4-5
# Relay tuong thich OpenAI (neu dung): LLM_PROVIDER=openai, LLM_BASE_URL=https://<relay>/v1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=60
INTERNAL_API_KEY=khoa-noi-bo-backend-goi-ai

# ---------- Quy tÃ¡ÂºÂ¯c kinh doanh ----------
FREE_SHIP_THRESHOLD=200000
DEFAULT_SHIPPING_FEE=20000

# ---------- Frontend (React) ----------
VITE_API_URL=/api/v1
